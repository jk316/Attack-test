\nfrom trex_astf_lib.api import *\n\n\nclass HttpGetFlood(ASTFProfile):\n    \"\"\"ASTF 有状态 profile：构造 HTTP GET 洪水流量。\"\"\"\n\n    def __init__(self, host, reqs_per_conn):\n        super(HttpGetFlood, self).__init__()\n        self.host = host\n        self.reqs_per_conn = reqs_per_conn\n\n    def create_streams(self, program):\n        # ---- 服务端程序：接受连接并循环响应，直到客户端关闭 ----\n        server_program = ASTFProgram()\n        server_program.wait_for_accept()\n        for _ in range(self.reqs_per_conn):\n            server_program.recv(1024)\n            server_program.send(\n                \"HTTP/1.1 200 OK\\r\\n\"\n                \"Content-Type: text/plain\\r\\n\"\n                \"Content-Length: 2\\r\\n\"\n                \"Connection: keep-alive\\r\\n\\r\\n\"\n                \"OK\"\n            )\n        server_program.close()\n\n        # ---- 客户端程序：建连后循环发送 GET，模拟高并发请求 ----\n        client_program = ASTFProgram()\n        client_program.connect()\n        for i in range(self.reqs_per_conn):\n            req = (\n                \"GET /index.html?q=%d HTTP/1.1\\r\\n\"\n                \"Host: %s\\r\\n\"\n                \"User-Agent: Mozilla/5.0 (TRex-Flood)\\r\\n\"\n                \"Accept: */*\\r\\n\"\n                \"Connection: keep-alive\\r\\n\\r\\n\" % (i, self.host)\n            )\n            client_program.send(req)\n            client_program.recv(2048)\n        client_program.close()\n\n        # ---- 组装模板并加入 program ----\n        template = ASTFTemplate(client_program=client_program,\n                                server_program=server_program)\n        program.add_traffic(ASTFTraffic(template=template))\n\n        # ---- 客户端 IP 池：分散源地址，规避五元组收敛 ----\n        program.set_ip_gen(\n            ASTFIPGen(\n                glob=ASTFIPGenGlobal(ip_offset=\"16.0.0.0\"),\n                distrib=ASTFIPGenDist(\n                    ip_range=[\"16.0.0.1\", \"16.0.255.255\"],\n                    distribution=\"seq\",\n                ),\n            )\n   